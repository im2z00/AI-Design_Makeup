# Vercel 프로젝트 Settings → Environment Variables 에 아래 값을 넣으세요. 이 파일에 실제 키를 적어 올리지 마세요.
ANTHROPIC_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 선택: 다른 모델을 쓰고 싶을 때 (기본 claude-opus-5-5)
CLAUDE_MODEL=
# 선택: 이 서버를 다른 사이트에서도 부르게 할 때만 (쉼표로 구분, 예: https://my-site.github.io)
ALLOWED_ORIGINS=
# 선택: 제품 검색 때 웹 검색 끄기(off). 기본은 켜짐 — 검색 1회마다 요금이 추가돼요
WEB_SEARCH=
# 선택: 요청 1번에 웹 검색을 최대 몇 번까지 할지 (기본 4)
WEB_SEARCH_MAX_USES=
